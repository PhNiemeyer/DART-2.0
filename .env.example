# DART 2.0 – Beispielkonfiguration für die LOKALE Entwicklung.
# Alle Werte sind Demo-Werte. In Produktion verweigern API und Vault den Start mit diesen Werten.
NODE_ENV=development
# Kern-Datenbank (PostgreSQL 18)
POSTGRES_PASSWORD=demo-superuser
DART_OWNER_PASSWORD=demo-owner
DART_APP_PASSWORD=demo-app
DART_WORKER_PASSWORD=demo-worker
DART_MIGRATION_PASSWORD=demo-migration
# Vault-Datenbank (eigener Server)
VAULT_POSTGRES_PASSWORD=demo-vault-superuser
VAULT_OWNER_PASSWORD=demo-vault-owner
VAULT_APP_PASSWORD=demo-vault-app
# Schlüssel des Vault (Base64, 32 Byte) – NUR lokal
VAULT_DATA_KEY=ZGVtby1kZW1vLWRlbW8tZGVtby1kZW1vLWRlbW8tMzI=
VAULT_INDEX_KEY=ZGVtby1pbmRleC1rZXktbnVyLWxva2FsLWVudHdpY2s=
VAULT_TOKEN_API=demo-vault-token-api-0000000000
VAULT_TOKEN_WORKER=demo-vault-token-worker-00000000
# Sitzungen
SESSION_SECRET=demo-session-secret-nur-fuer-lokale-entwicklung-0000
# Anmeldung: dev (Demo-Nutzerauswahl) oder oidc (Keycloak)
AUTH_MODE=dev
# S3-kompatibler Speicher (SeaweedFS lokal)
S3_ACCESS_KEY_ID=demo-s3-access
S3_SECRET_ACCESS_KEY=demo-s3-secret-000000
# Keycloak
KEYCLOAK_ADMIN_PASSWORD=demo-keycloak-admin
OIDC_CLIENT_SECRET=demo-oidc-client-secret-000000
# Öffentliche URL der Webanwendung
PUBLIC_WEB_URL=http://localhost:3000
