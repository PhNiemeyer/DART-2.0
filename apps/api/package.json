{
  "name": "@dart/api",
  "version": "0.1.0",
  "private": true,
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "tsc -p tsconfig.json --noEmit",
    "start": "node dist/main.js",
    "seed": "node dist/seed.js",
    "openapi": "node dist/openapi.js",
    "test": "vitest run --no-file-parallelism"
  },
  "dependencies": {
    "@dart/contracts": "workspace:*",
    "@dart/domain": "workspace:*",
    "@dart/forms": "workspace:*",
    "@nestjs/common": "11.2.8",
    "@nestjs/core": "11.2.8",
    "@nestjs/platform-express": "11.2.8",
    "@nestjs/swagger": "11.4.7",
    "cookie-parser": "1.4.7",
    "helmet": "8.3.0",
    "jose": "6.2.15",
    "pg": "8.23.1",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "4.6.7",
    "express": "5.3.0"
  },
  "devDependencies": {
    "@types/cookie-parser": "1.4.10",
    "@types/express": "5.0.6",
    "@types/pg": "8.23.1",
    "@types/supertest": "7.2.1",
    "supertest": "7.3.1",
    "typescript": "5.9.3",
    "vitest": "3.2.7"
  }
}
