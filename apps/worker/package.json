    "start": "node dist/main.js",
    "test": "vitest run --no-file-parallelism"
  },
  "dependencies": {
    "@dart/domain": "workspace:*",
    "@dart/forms": "workspace:*",
    "nodemailer": "10.2.1",
    "pg": "8.23.1"
  },
  "devDependencies": {
    "@types/nodemailer": "8.0.2",
    "@types/pg": "8.23.1",
    "typescript": "5.9.3",
    "vitest": "3.2.7"
  }
}
